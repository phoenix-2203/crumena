# Copy to server/.env (the relayer) and server/.env.seed (deploy + testnet run).
# Use a THROWAWAY testnet account only. Never commit these files, never paste the phrase anywhere.
# Scripts refuse to run on an account holding more than 200 QOR.

# server/.env
RELAYER_MNEMONIC=""
# EARMARK_ADDRESS=""   # optional; otherwise read from deployments/testnet.json
# PORT=8790

# server/.env.seed
E2E_MNEMONIC=""

# Optional overrides
# QORE_REST="https://api-testnet.qore.host"
# QORE_EVM_RPC="https://evm-testnet.qore.host"
