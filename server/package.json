{
  "name": "@earmark/server",
  "version": "0.1.0",
  "private": true,
  "description": "Earmark's relayer: sends post-quantum signed actions to the Earmark contract, from a scoped EVM window.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:testnet": "node --env-file-if-exists=.env.seed --import tsx scripts/deploy.ts",
    "testnet:run": "node --env-file-if-exists=.env.seed --import tsx scripts/testnet-run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/sdk": "^0.14.0",
    "cosmjs-types": "^0.9.0",
    "hono": "^4.7.10",
    "tsx": "^4.19.4",
    "viem": "~2.53.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
